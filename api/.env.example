# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Fila de enriquecimento de cadastro. `localhost` para rodar a API na
# maquina; dentro do docker-compose o hostname e `broker`, e o compose
# sobrescreve esta variavel explicitamente.
BROKER_URL="amqp://guest:guest@localhost:5672"
BROKER_USERNAME="guest"
BROKER_PASSWORD="guest"

# Timeout das integracoes HTTP (cadastro e agendamento). Padrao: 5000ms.
# Vale para os dois adapters ao mesmo tempo: eles dividem o token.
HTTP_TIMEOUT_MS=5000
