# Conexao com o PostgreSQL. Dentro do docker-compose o hostname e `db`.
DATABASE_URL="postgresql://desafio:desafio@localhost:5432/checkin?schema=public"

# Fila de enriquecimento de cadastro. `localhost` para rodar a API na
# maquina; dentro do docker-compose o hostname e `broker`, e o compose
# sobrescreve esta variavel explicitamente.
BROKER_URL="amqp://guest:guest@localhost:5672"
BROKER_USERNAME="guest"
BROKER_PASSWORD="guest"

# Integracao REST de cadastro (mock-service na porta 4000).
CADASTRO_URL="http://localhost:4000"

# Legado XML de agendamento (legacy-service na porta 4100).
AGENDAMENTO_URL="http://localhost:4100"

# Timeout das integracoes HTTP (cadastro e agendamento). Padrao: 5000ms.
# Vale para os dois adapters ao mesmo tempo: eles dividem o token.
HTTP_TIMEOUT_MS=5000

# Intervalo do dispatcher do outbox, em milissegundos. Padrao: 5000ms.
OUTBOX_INTERVAL_MS=5000

# Lote de eventos lidos por volta do dispatcher. Padrao: 20.
OUTBOX_LOTE=20